# Required
OPENAI_API_KEY=
# Script step: Responses API (pin snapshot). Override if needed.
OPENAI_TEXT_MODEL=gpt-5.4-2026-03-05

# OpenAI TTS voiceover (mixed under Suno in the final mix)
TTS_ENABLED=true
TTS_MODEL=tts-1
# alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=nova
TTS_MUSIC_VOLUME=0.14
TTS_VOICE_VOLUME=1.25
# Slideshow: seconds per image; reel length capped (extra images omitted)
MAX_VIDEO_DURATION_SEC=30
SLIDE_DURATION_SEC=3

# kie.ai Suno (required for music step)
KIE_API_KEY=
# Affordable default: V4 (entry tier). Alternatives: V4_5, V4_5PLUS, V4_5ALL, V5, V5_5
KIE_SUNO_MODEL=V4
# Public URL Suno POSTs to; polling still works if unreachable
KIE_CALLBACK_URL=https://httpbin.org/post

# Unkey — set UNKEY_VERIFY=true to require Authorization: Bearer <key>
UNKEY_VERIFY=false
# If your Unkey project requires root auth for verify (optional)
UNKEY_ROOT_KEY=

# Server
PORT=8000
CORS_ORIGINS=*
